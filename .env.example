# ==============================================================================
# CodeCraft — Environment Configuration
# ==============================================================================

# Server & Network Ports
PORT=3001
HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:3001

# AI Model Provider Configuration
# Supported providers: openai | anthropic | openrouter | ollama
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama Configuration (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# SQLite Database Storage Location
DATABASE_URL=./data/db.sqlite

# JWT Secret for Session Authentication
JWT_SECRET=super-secret-codecraft-jwt-key-change-in-production

# Docker Sandbox Settings
DOCKER_SOCKET_PATH=/var/run/docker.sock
RUNNER_DOCKER_IMAGE=codecraft-runner:latest
PREVIEW_DOCKER_IMAGE=codecraft-preview:latest
