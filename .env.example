# ==============================================================================
# CodeCraft - Self-Hostable AI Web App Builder Environment Configuration
# ==============================================================================

# Server & Network Configuration
NODE_ENV=production
PORT=3001
WEB_PORT=3000
HOST=0.0.0.0
DATABASE_URL=data/db.sqlite
JWT_SECRET=replace-this-with-a-secure-random-secret-key

# AI Provider Selection: 'openai' | 'anthropic' | 'openrouter' | 'ollama'
AI_PROVIDER=openai

# Provider API Keys (Fill the one corresponding to AI_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama URL (Default: http://localhost:11434 for local, http://host.docker.internal:11434 for Docker)
OLLAMA_BASE_URL=http://localhost:11434

# Logging
LOG_LEVEL=info
