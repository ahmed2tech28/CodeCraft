# ==============================================================================
# CodeCraft - Self-Hostable AI Web App Builder Environment Configuration
# ==============================================================================

# Server & Network Configuration
NODE_ENV=production
PORT=3001
WEB_PORT=3000
HOST=0.0.0.0
DATABASE_URL=data/db.sqlite
JWT_SECRET=replace-this-with-a-secure-random-secret-key

# ==============================================================================
# AI Provider Selection
# Options: 'openrouter' | 'openai' | 'anthropic' | 'ollama' | 'gemini'
# ==============================================================================
AI_PROVIDER=openrouter
AI_MODEL=google/gemma-4-31b-it:free

# --- OpenRouter (recommended for free models) ---
# Create a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Google Gemini (direct API) ---
# Get a free key at: https://aistudio.google.com/app/apikey
# For Gemini provider, set: AI_PROVIDER=gemini  AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=

# --- Local Ollama (no API key needed) ---
# For Docker: http://host.docker.internal:11434
# For local dev: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# Docker Sandbox Configuration
# ==============================================================================

# The Docker image used for per-project runner and preview containers.
# Build it with: docker build -f docker/sandbox/Dockerfile -t codecraft-sandbox:latest .
SANDBOX_DOCKER_IMAGE=codecraft-sandbox:latest

# Public host for preview URLs.
# When running in Docker, set this to your machine's LAN IP or domain so the
# browser can reach preview containers from outside Docker.
# Examples:
#   PUBLIC_HOST=192.168.1.100       (LAN IP)
#   PUBLIC_HOST=myserver.example.com (domain)
# For local dev without Docker: leave as localhost
PUBLIC_HOST=localhost

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=info
